#!/bin/bash
# Pre-commit hook to validate web routes

# Only run if web/ files changed
if git diff --cached --name-only | grep -q "^web/"; then
  echo "Validating web API routes..."
  if ! ./scripts/validate-web-routes.sh; then
    echo ""
    echo "❌ Commit blocked: Missing web proxy routes detected"
    echo "   Fix the issues above before committing"
    exit 1
  fi
fi

exit 0
