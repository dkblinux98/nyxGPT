# nyxGPT FastAPI backend (uvicorn) -- systemd --user unit.
#
# Source template: `nyxgpt ops install` copies this into
# ~/.config/systemd/user/, substituting __NYXGPT_HOME__ with the installing
# user's actual home directory (see _install_systemd_unit_from_template in
# src/nyxgpt/ops.py). Linux twin of homebrew/nyxgpt-api.rb's `service` block:
# runs the wrapper script `_install_native_api_systemd` writes to
# ~/.nyxGPT/opt/nyxgpt-api/bin/nyxgpt-api, which execs uvicorn from a
# self-contained venv the same way the wrapper Homebrew's Cellar keg builds
# does on macOS -- the installed app never depends on the repo checkout.
[Unit]
Description=nyxGPT FastAPI backend (uvicorn)
After=network.target

[Service]
Type=simple
ExecStart=__NYXGPT_HOME__/.nyxGPT/opt/nyxgpt-api/bin/nyxgpt-api
Restart=always
RestartSec=5
StandardOutput=append:__NYXGPT_HOME__/.nyxGPT/logs/nyxgpt-api.log
StandardError=append:__NYXGPT_HOME__/.nyxGPT/logs/nyxgpt-api.err.log

[Install]
WantedBy=default.target
