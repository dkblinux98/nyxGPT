{
  "mcpServers": {
    "github": {
      "command": "bash",
      "args": [
        "-c",
        "GITHUB_PERSONAL_ACCESS_TOKEN=$(python3 -c \"import configparser,os; c=configparser.ConfigParser(); c.read(os.path.expanduser('~/.nyxGPT/config.ini')); print(c.get('github','pat',fallback='').strip())\") npx -y @github/mcp-server"
      ]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    }
  }
}
