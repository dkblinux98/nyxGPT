#!/bin/bash
# EC2 user-data bootstrap: EC2 Mac (target-OS provisioning, P6-12/#3511).
#
# Installs nyxGPT from the published remote Homebrew tap (P6-5, #3622) and
# brings up the native (Homebrew services + launchd) stack -- exactly the
# flow docs/homebrew.md documents for local macOS installs
# (`brew tap`/`brew tap-trust`/`brew install nyxgpt-api nyxgpt-web`/
# `brew services start`).
# Two ways in, and it must run as root either way:
#   * `nyxgpt cloud deploy --os macos --host <mac>` pipes it over SSH and
#     elevates with `sudo -n` in ec2-macos-init's place (#3867). This is the
#     wrapped, user-facing path -- nothing is ever pasted anywhere.
#   * EC2 Mac's `ec2-macos-init` first-boot user-data support (AWS's own
#     agent for Mac instances -- there is no cloud-init on macOS), for an
#     instance launched by something other than nyxGPT.
#
# Repo-less (CLAUDE.md, 2026-08-01): this script never runs `git clone` --
# the remote Homebrew tap is the only source of the application, so it works
# on a target instance with no repo checkout. `nyxgpt ops install`'s macOS
# path is NOT used here: that path builds a *local* tap from a repo
# checkout (see src/nyxgpt/ops.py's `_install_homebrew_api`), which doesn't
# exist on a fresh instance -- the documented remote-tap flow below is the
# one already proven repo-less (docs/homebrew.md#remote-tap).
#
# Rendered by `nyxgpt cloud user-data --os macos` and by `nyxgpt cloud deploy
# --os macos` (src/nyxgpt/cloud_provision.py's render_user_data, called by
# cloud_deploy.render_provision_script -- one renderer, not two copies).
# --version is accepted for interface parity with the Linux template's
# --version flag and recorded in NYXGPT_VERSION below, but only for
# reference: Homebrew formulas track the tap's current formula, not an
# arbitrary pinned release, so this script always installs whatever
# `dkblinux98/homebrew-nyxgpt` currently serves.
#
# Supported instance types and macOS versions: see docs/cloud.md's
# target-OS support matrix. EC2 Mac requires a Dedicated Host, allocated for
# a 24-hour minimum -- an AWS billing/allocation constraint, not a nyxGPT
# one. nyxGPT deliberately does not allocate one: `nyxgpt cloud deploy --os
# macos` refuses, naming the constraint, rather than spending that on a
# resource the substrate could not then release (#3867).
set -euxo pipefail

# nyxgpt version requested at render time (informational only -- see above).
NYXGPT_VERSION="__NYXGPT_VERSION__"

# Chat session storage backend for this instance (#3865), filled in by
# `nyxgpt cloud user-data --session-backend`. Defaults to `file` for this
# template, unlike the Linux one: nothing here provisions a Cassandra (this
# script does not run `ops install`'s macOS path -- see the header), so
# defaulting to `cassandra` would point the API at a database that is not on
# the machine. Passing `--session-backend cassandra` is still supported, for
# an operator who points `[rag] cassandra_hosts` at a Cassandra they run
# elsewhere. See docs/session-storage.md.
NYXGPT_SESSION_BACKEND_CHOICE="__NYXGPT_SESSION_BACKEND__"

if [ "$(id -u)" -ne 0 ]; then
  echo "ec2-user-data-macos: must run as root (ec2-macos-init user-data does by default)" >&2
  exit 1
fi

# AWS's own macOS AMIs default to 'ec2-user'.
NYXGPT_TARGET_USER="${NYXGPT_TARGET_USER:-ec2-user}"
TARGET_HOME=$(dscl . -read "/Users/$NYXGPT_TARGET_USER" NFSHomeDirectory 2>/dev/null | awk '{print $2}')
if [ -z "$TARGET_HOME" ]; then
  echo "ec2-user-data-macos: user '$NYXGPT_TARGET_USER' does not exist on this instance" >&2
  exit 1
fi

if ! sudo -u "$NYXGPT_TARGET_USER" -H bash -lc 'command -v brew' >/dev/null 2>&1; then
  NONINTERACTIVE=1 sudo -u "$NYXGPT_TARGET_USER" -H /bin/bash -c \
    "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
BREW_BIN=$(sudo -u "$NYXGPT_TARGET_USER" -H bash -lc 'command -v brew')

sudo -u "$NYXGPT_TARGET_USER" -H "$BREW_BIN" tap dkblinux98/nyxgpt
# Homebrew gates installs from third-party taps, and this script is
# non-interactive: without the trust step the `brew install` below stops at
# the prompt and provisioning dead-ends (#3752). Trust is per tap, which is
# what the install below needs -- a per-formula grant does not cover the
# counterpart formula `conflicts_with` makes brew load (#3770). That applies
# to the STABLE install this script runs since #3853, not only to a candidate
# one: the stable formula now declares the conflict too, so `brew install
# nyxgpt-api` loads `nyxgpt-api@<line>rc` on its way in. The
# subcommand is spelled `tap-trust` on some Homebrews and `trust` on others,
# so try both; failing both is tolerated -- a Homebrew old enough not to
# gate has neither subcommand and nothing to trust.
sudo -u "$NYXGPT_TARGET_USER" -H "$BREW_BIN" tap-trust dkblinux98/nyxgpt \
  || sudo -u "$NYXGPT_TARGET_USER" -H "$BREW_BIN" trust dkblinux98/nyxgpt || true
sudo -u "$NYXGPT_TARGET_USER" -H "$BREW_BIN" install nyxgpt-api nyxgpt-web

sudo -u "$NYXGPT_TARGET_USER" -H mkdir -p "$TARGET_HOME/.nyxGPT"
if [ ! -f "$TARGET_HOME/.nyxGPT/config.ini" ]; then
  EXAMPLE_CONFIG="$($BREW_BIN --prefix)/opt/nyxgpt-api/libexec/venv/lib/python3.12/site-packages/nyxgpt/example.config.ini"
  sudo -u "$NYXGPT_TARGET_USER" -H cp "$EXAMPLE_CONFIG" "$TARGET_HOME/.nyxGPT/config.ini"
fi

# Apply the session-backend choice before the services start, so the API's
# first run already reads the intended backend (#3865). The `nyxgpt` console
# script is the one the api keg symlinks onto the PATH
# (`bin.install_symlink venv/"bin/nyxgpt"` in homebrew/tap/nyxgpt-api.rb.tmpl);
# addressed through the keg rather than the PATH so this does not depend on
# `brew link` having run for this shell. Idempotent -- it writes only when the
# value actually changes.
NYXGPT_CLI="$($BREW_BIN --prefix)/opt/nyxgpt-api/libexec/venv/bin/nyxgpt"
sudo -u "$NYXGPT_TARGET_USER" -H "$NYXGPT_CLI" ops session-backend "$NYXGPT_SESSION_BACKEND_CHOICE"

sudo -u "$NYXGPT_TARGET_USER" -H "$BREW_BIN" services start nyxgpt-api
sudo -u "$NYXGPT_TARGET_USER" -H "$BREW_BIN" services start nyxgpt-web

echo "ec2-user-data-macos: nyxGPT installed and started for user '$NYXGPT_TARGET_USER'"
