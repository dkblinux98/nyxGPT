#!/usr/bin/env bash
# EC2 user-data bootstrap: Linux AMI (target-OS provisioning, P6-12/#3511).
#
# Installs nyxGPT from the published PyPI artifact (P6-5, #3504/#3622) and
# brings up the native (systemd --user) stack (#3508) -- the same install
# path scripts/systemd-native-smoke.sh exercises in CI, run here as EC2
# cloud-init user-data instead of an interactive SSH session.
#
# Repo-less (CLAUDE.md, 2026-08-01): this script never runs `git clone` --
# `pip install nyxgpt` is the only source of the application, so it works on
# a target instance with no repo checkout.
#
# Rendered by `nyxgpt cloud user-data --os linux` (src/nyxgpt/cloud_provision.py),
# which fills in NYXGPT_VERSION below with a pinned PyPI version (from
# --version), or leaves it blank for "latest". The result is meant to be
# used verbatim as an EC2 instance's user-data (cloud-init runs it as root
# on first boot).
#
# Supported AMI families and instance types: see docs/cloud.md's target-OS
# support matrix.
set -euxo pipefail

NYXGPT_VERSION="__NYXGPT_VERSION__"
# Override to target a login user other than the AMI's default (rarely
# needed -- only if a custom AMI ships a different default account).
NYXGPT_TARGET_USER="${NYXGPT_TARGET_USER:-}"

if [ "$(id -u)" -ne 0 ]; then
  echo "ec2-user-data-linux: must run as root (EC2 user-data does by default)" >&2
  exit 1
fi

# The native install path is per-user (systemd --user, never root) -- resolve
# the AMI's default non-root login account so services run under it, exactly
# like a manual `nyxgpt ops install` would on an interactive SSH session.
if [ -z "$NYXGPT_TARGET_USER" ]; then
  # shellcheck disable=SC1091
  . /etc/os-release
  case "$ID" in
    amzn) NYXGPT_TARGET_USER="ec2-user" ;;
    ubuntu) NYXGPT_TARGET_USER="ubuntu" ;;
    *)
      echo "ec2-user-data-linux: unrecognized distro ID='$ID' -- set NYXGPT_TARGET_USER explicitly (see docs/cloud.md's target-OS support matrix)" >&2
      exit 1
      ;;
  esac
fi

TARGET_HOME=$(getent passwd "$NYXGPT_TARGET_USER" | cut -d: -f6)
if [ -z "$TARGET_HOME" ]; then
  echo "ec2-user-data-linux: user '$NYXGPT_TARGET_USER' does not exist on this instance" >&2
  exit 1
fi

# --- Prerequisites `nyxgpt ops install` needs on a bare AMI -----------------
#
# `ops install` is not self-contained: it builds a Python venv for
# nyxgpt-api, runs `npm ci`/`npm run build` for nyxgpt-web, and creates the
# `nyxgpt-cassandra` Docker container (`_ensure_cassandra_container` in
# src/nyxgpt/ops.py -- the one Docker-managed piece of an otherwise-native
# install). None of Python-venv, Node/npm, or a Docker engine ship on a
# stock Amazon Linux 2023 or Canonical Ubuntu AMI, and each missing one is a
# hard failure inside `ops install`, which exits non-zero and, under `set
# -e`, aborts this whole bootstrap. Install them before we get there.
#
# `zstd` is in the list because Ollama's official installer refuses to run
# without it ("This version requires zstd for extraction"), which aborts this
# bootstrap under `set -e` before `ops install` is ever reached. Found by
# `nyxgpt cloud smoke --container` (#3784) on a bare Amazon Linux 2023
# machine; installing it is a no-op on an AMI that already has it.
if command -v dnf >/dev/null 2>&1; then
  dnf install -y python3 python3-pip docker zstd
  # Amazon Linux 2023's `python3` is 3.9, below nyxGPT's requires-python
  # floor of 3.11 -- installing an explicit 3.11+ is what makes the CLI venv
  # below installable at all (#3782). Newest first, stopping at the first
  # that installs.
  for pkg in python3.13 python3.12 python3.11; do
    if dnf install -y "$pkg" "$pkg-pip"; then
      break
    fi
  done
elif command -v apt-get >/dev/null 2>&1; then
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -y
  apt-get install -y python3 python3-pip python3-venv docker.io zstd
  # Ubuntu 22.04 LTS (in the support matrix) ships 3.10 as `python3`.
  if ! python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)'; then
    apt-get install -y python3.11 python3.11-venv || true
  fi
else
  echo "ec2-user-data-linux: no supported package manager found (need dnf or apt-get)" >&2
  exit 1
fi

# Resolve the interpreter the CLI venv is built from, asking each candidate
# its own version rather than trusting its name. Bare `python3` is tried last
# and only if it satisfies the floor: a venv built from a 3.9 `python3` is
# one pip refuses to install nyxGPT into ("requires a different Python:
# 3.9.16 not in '>=3.11'"), which is how #3782 failed a cloud deploy several
# minutes in, with no mention of Python in the error.
NYXGPT_PYTHON=""
for cand in python3.13 python3.12 python3.11 python3; do
  command -v "$cand" >/dev/null 2>&1 || continue
  if "$cand" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)'; then
    NYXGPT_PYTHON="$(command -v "$cand")"
    break
  fi
done
if [ -z "$NYXGPT_PYTHON" ]; then
  echo "ec2-user-data-linux: no Python >= 3.11 is installed or installable on this AMI -- nyxGPT's requires-python is '>=3.11' (system python3: $(python3 -V 2>&1 || echo none))" >&2
  exit 1
fi

# Node 20 from NodeSource rather than the distro repos: Ubuntu 22.04 LTS
# still ships Node 12 and AL2023 ships Node 18, both below the Node 20 the
# web bundle's build is standardized on (see linux-native-smoke.yml).
NODE_MAJOR=0
if command -v node >/dev/null 2>&1; then
  NODE_MAJOR=$(node -v | sed 's/^v//' | cut -d. -f1)
fi
if ! command -v npm >/dev/null 2>&1 || [ "$NODE_MAJOR" -lt 20 ]; then
  if command -v dnf >/dev/null 2>&1; then
    curl -fsSL https://rpm.nodesource.com/setup_20.x | bash -
    dnf install -y nodejs
  else
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
    apt-get install -y nodejs
  fi
fi

# The engine is installed but inert on a fresh AMI, and the target user is
# not in the `docker` group. Both matter: `ops install` shells out to
# `docker` as the *target user*, never as root. `sudo -u` re-reads group
# membership at every invocation (initgroups), so the calls below pick the
# new group up without needing a re-login.
systemctl enable --now docker
usermod -aG docker "$NYXGPT_TARGET_USER"
for _ in $(seq 1 30); do
  if docker info >/dev/null 2>&1; then
    break
  fi
  sleep 2
done
if ! docker info >/dev/null 2>&1; then
  echo "ec2-user-data-linux: the Docker daemon never became ready -- 'nyxgpt ops install' cannot create the nyxgpt-cassandra container without it" >&2
  exit 1
fi

# Install nyxgpt from PyPI as the target user, never root -- no repo clone.
# A dedicated venv rather than `pip install --user`: Ubuntu 24.04 LTS marks
# its system Python PEP 668 externally-managed, which makes a `--user`
# install a hard error (`externally-managed-environment`), and 24.04 is in
# the support matrix. `ops install` builds its own self-contained venvs for
# the API and web services regardless, so this venv only ever holds the
# `nyxgpt` CLI that drives them.
PIP_SPEC="nyxgpt"
if [ -n "$NYXGPT_VERSION" ]; then
  PIP_SPEC="nyxgpt==${NYXGPT_VERSION}"
fi
# Escape hatch for testing an artifact PyPI does not serve: the containerized
# artifact smoke (`nyxgpt cloud smoke --container`, #3784) points this at a
# wheel it built from the tree under test and copied into the machine, so a
# branch whose version is not published yet still gets its install path
# exercised. Unset on a real instance, which installs from PyPI.
if [ -n "${NYXGPT_PIP_SPEC:-}" ]; then
  PIP_SPEC="$NYXGPT_PIP_SPEC"
fi
CLI_VENV="$TARGET_HOME/.nyxGPT/opt/nyxgpt-cli"
USER_BIN="$CLI_VENV/bin"
NYXGPT_CLI="$USER_BIN/nyxgpt"

sudo -u "$NYXGPT_TARGET_USER" -H mkdir -p "$TARGET_HOME/.nyxGPT/opt"
sudo -u "$NYXGPT_TARGET_USER" -H "$NYXGPT_PYTHON" -m venv "$CLI_VENV"
sudo -u "$NYXGPT_TARGET_USER" -H "$CLI_VENV/bin/python" -m pip install --upgrade pip
sudo -u "$NYXGPT_TARGET_USER" -H "$CLI_VENV/bin/python" -m pip install "$PIP_SPEC"

# Ollama's official installer (also no repo clone).
if ! command -v ollama >/dev/null 2>&1; then
  curl -fsSL https://ollama.com/install.sh | sh
fi

# There is no interactive login on first boot, so a systemd --user unit
# needs lingering enabled to keep running once user-data finishes. Lingering
# is also what makes systemd-logind create the target user's runtime
# directory (/run/user/<uid>) and start its per-user D-Bus bus -- without
# those, `systemctl --user` has nothing to talk to.
loginctl enable-linger "$NYXGPT_TARGET_USER"

TARGET_UID=$(id -u "$NYXGPT_TARGET_USER")
TARGET_RUNTIME_DIR="/run/user/$TARGET_UID"

# logind brings the user manager (and its bus socket) up asynchronously, so
# `enable-linger` returning does not mean the bus is there yet.
for _ in $(seq 1 60); do
  if [ -S "$TARGET_RUNTIME_DIR/bus" ]; then
    break
  fi
  sleep 1
done
if [ ! -S "$TARGET_RUNTIME_DIR/bus" ]; then
  echo "ec2-user-data-linux: $TARGET_RUNTIME_DIR/bus never appeared after 'loginctl enable-linger $NYXGPT_TARGET_USER' -- systemd --user is unusable for this account" >&2
  exit 1
fi

# `sudo -u` starts a bare process with none of a login session's
# environment. Without XDG_RUNTIME_DIR/DBUS_SESSION_BUS_ADDRESS the
# `systemctl --user` calls inside `nyxgpt ops install` cannot reach the
# target user's service manager, so every unit it installs fails to
# enable/start, `ops install` exits non-zero, and `set -e` aborts this
# bootstrap. Forward the two variables an interactive login would have set.
run_as_target() {
  sudo -u "$NYXGPT_TARGET_USER" -H \
    env "PATH=$USER_BIN:$PATH" \
        "XDG_RUNTIME_DIR=$TARGET_RUNTIME_DIR" \
        "DBUS_SESSION_BUS_ADDRESS=unix:path=$TARGET_RUNTIME_DIR/bus" \
        "$@"
}

# Fail here, with a message naming the actual problem, rather than part-way
# through `ops install` with a pile of unit-start errors.
if ! run_as_target systemctl --user show-environment >/dev/null; then
  echo "ec2-user-data-linux: 'systemctl --user' is not reachable as '$NYXGPT_TARGET_USER' -- the user service manager did not start" >&2
  exit 1
fi
if ! run_as_target docker info >/dev/null 2>&1; then
  echo "ec2-user-data-linux: '$NYXGPT_TARGET_USER' cannot reach the Docker daemon -- docker-group membership did not take effect" >&2
  exit 1
fi

if [ ! -f "$TARGET_HOME/.nyxGPT/config.ini" ]; then
  EXAMPLE_CONFIG=$(run_as_target "$CLI_VENV/bin/python" -c \
    "from nyxgpt import config_wizard; print(config_wizard._EXAMPLE_CONFIG_PATH)")
  run_as_target cp "$EXAMPLE_CONFIG" "$TARGET_HOME/.nyxGPT/config.ini"
fi

run_as_target "$NYXGPT_CLI" ops install --skip-observability

echo "ec2-user-data-linux: nyxGPT installed and started for user '$NYXGPT_TARGET_USER'"
