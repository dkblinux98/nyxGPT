# Environment template for docker-compose.yml.
# Copy to .env and adjust as needed:
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Ports (host-side)
# ---------------------------------------------------------------------------
NYXGPT_API_PORT=8000
NYXGPT_WEB_PORT=3000
OLLAMA_PORT=11434
CASSANDRA_PORT=9042
# Only used with `docker compose --profile tracing up` (see docs/docker-compose.md)
JAEGER_UI_PORT=16686
# Only used with `docker compose --profile errors up` (see docs/docker-compose.md)
GLITCHTIP_UI_PORT=8080
# Only used with `docker compose --profile monitoring up` (see docs/docker-compose.md)
PROMETHEUS_UI_PORT=9090
GRAFANA_UI_PORT=3001

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Shared secret required by the API's [auth] section (see
# docker/config.docker.ini). Required since the web container reaches the
# API over the compose network rather than localhost. Set this to a real
# value before running `docker compose up`.
NYXGPT_AUTH_API_KEY=change-me

# Comma-separated origins allowed to call the API via CORS.
NYXGPT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Django secret key for the self-hosted GlitchTip error tracker. Only used
# with `docker compose --profile errors up`. Set this to a real value before
# running that profile.
GLITCHTIP_SECRET_KEY=change-me

# Admin password for the local Grafana instance. Only used with
# `docker compose --profile monitoring up`. Set this to a real value before
# running that profile.
GRAFANA_ADMIN_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Web UI
# ---------------------------------------------------------------------------
# Base URL the web UI's browser bundle uses to reach the API. This is baked
# into the web image at build time (Next.js inlines NEXT_PUBLIC_* vars), so
# changing it requires rebuilding: `docker compose build web`.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Image tags (leave as "local" to always build from source)
# ---------------------------------------------------------------------------
NYXGPT_API_IMAGE_TAG=local
NYXGPT_WEB_IMAGE_TAG=local
