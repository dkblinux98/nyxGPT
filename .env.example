# Environment template for docker-compose.yml.
#
# Non-secret values (ports, image tags) can be copied and adjusted by hand:
#   cp .env.example .env
#
# Secret values (NYXGPT_AUTH_API_KEY, GRAFANA_ADMIN_PASSWORD) should NOT be
# hand-edited here. ~/.nyxGPT/config.ini (generated by `nyxgpt wizard`) is
# their single source of truth -- run `nyxgpt ops env-sync` to derive this
# file's secret lines from it.

# ---------------------------------------------------------------------------
# Network binding
# ---------------------------------------------------------------------------
# Host-side bind address every published port below uses. Defaults to
# 127.0.0.1 (workstation-only, matching the native deployment's posture --
# see docs/security.md#network-security). Only set this to 0.0.0.0 (or a
# specific LAN address) if you also set `[auth] enabled = true` in
# ~/.nyxGPT/config.ini -- otherwise the stack becomes reachable, and
# unauthenticated, to anyone on the same network.
NYXGPT_BIND_ADDR=127.0.0.1

# ---------------------------------------------------------------------------
# Ports (host-side)
# ---------------------------------------------------------------------------
NYXGPT_API_PORT=8000
NYXGPT_WEB_PORT=3000
OLLAMA_PORT=11434
CASSANDRA_PORT=9042
# Only used with `docker compose --profile tracing up` (see docs/docker-compose.md).
# OTEL_COLLECTOR_HTTP_PORT must match [tracing] otlp_endpoint's port in
# ~/.nyxGPT/config.ini (default http://localhost:4318/v1/traces) -- this is
# the port the native api's OTLPSpanExporter actually posts spans to.
JAEGER_UI_PORT=16686
OTEL_COLLECTOR_HTTP_PORT=4318
OTEL_COLLECTOR_GRPC_PORT=4317
# Only used with `docker compose --profile errors up` (see docs/docker-compose.md)
GLITCHTIP_UI_PORT=8080
# Only used with `docker compose --profile monitoring up` (see docs/docker-compose.md)
PROMETHEUS_UI_PORT=9090
GRAFANA_UI_PORT=3001

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Shared secret required by the API's [auth] section (see
# docker/config.docker.ini). Required since the web container reaches the
# API over the compose network rather than localhost.
# Single source of truth: ~/.nyxGPT/config.ini's [auth] api_key -- run
# `nyxgpt ops env-sync` to populate this from it, rather than editing it here.
NYXGPT_AUTH_API_KEY=change-me

# Comma-separated origins allowed to call the API via CORS.
NYXGPT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Django secret key for the self-hosted GlitchTip error tracker. Only used
# with `docker compose --profile errors up`. Set this to a real value before
# running that profile.
GLITCHTIP_SECRET_KEY=change-me

# Admin password for the local Grafana instance. Only used with
# `docker compose --profile monitoring up`.
# Single source of truth: ~/.nyxGPT/config.ini's [monitoring]
# grafana_admin_password -- run `nyxgpt ops env-sync` to populate this from
# it, rather than editing it here.
GRAFANA_ADMIN_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Web UI
# ---------------------------------------------------------------------------
# Base URL the web UI's browser bundle uses to reach the API. This is baked
# into the web image at build time (Next.js inlines NEXT_PUBLIC_* vars), so
# changing it requires rebuilding: `docker compose build web`.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Image tags (leave as "local" to always build from source)
# ---------------------------------------------------------------------------
NYXGPT_API_IMAGE_TAG=local
NYXGPT_WEB_IMAGE_TAG=local
