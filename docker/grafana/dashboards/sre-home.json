      }
    },
    {
      "id": 22,
      "title": "GlitchTip: open issues (nyxgpt-backend)",
      "description": "True unresolved-issue count (via a limit high enough to return every row in one page, capped at GlitchTip's own 1000-issue hard limit) -- not a first-page row count, which pins at 50 once the true count reaches the default page size.",
      "type": "stat",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "glitchtip-infinity" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 91 },
      "links": [
        { "title": "GlitchTip UI", "url": "http://localhost:8080/nyxgpt/issues/", "targetBlank": true }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["count"], "fields": "/.*/" } },
      "targets": [
        {
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "glitchtip-infinity" },
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "/api/0/projects/nyxgpt/nyxgpt-backend/issues/?statsPeriod=24h&query=is%3Aunresolved&limit=1000",
          "url_options": { "method": "GET" },
          "root_selector": "",
          "columns": [{ "selector": "id", "text": "id", "type": "string" }],
          "refId": "A"
        }
      ]
    },
    {
      "id": 23,
      "title": "GlitchTip: recent errors (nyxgpt-backend)",
      "type": "table",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "glitchtip-infinity" },
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 91 },
      "links": [
        { "title": "GlitchTip UI", "url": "http://localhost:8080/nyxgpt/issues/", "targetBlank": true }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Issue" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "View in GlitchTip",
                    "url": "http://localhost:8080/nyxgpt/issues/${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "glitchtip-infinity" },
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "/api/0/projects/nyxgpt/nyxgpt-backend/issues/?statsPeriod=24h&query=is%3Aunresolved",
          "url_options": { "method": "GET" },
          "root_selector": "",
          "columns": [
            { "selector": "title", "text": "Title", "type": "string" },
            { "selector": "culprit", "text": "Culprit", "type": "string" },
            { "selector": "status", "text": "Status", "type": "string" },
            { "selector": "count", "text": "Events", "type": "number" },
            { "selector": "lastSeen", "text": "Last Seen", "type": "timestamp" },
            { "selector": "id", "text": "Issue", "type": "string" }
          ],
          "refId": "A"
        }
      ]
    }
  ]
}
