{
  "title": "nyxGPT / Self-Healing",
  "uid": "nyxgpt-self-healing",
  "tags": ["nyxgpt", "self-heal"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Unhealthy components (now)",
      "description": "Snapshot from the last self-heal check pass, not real-time -- see 'Unhealthy components by name' and 'Self-heal check freshness' below for which component(s) and how stale this count is.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nyxgpt_selfheal_unhealthy_components",
          "legendFormat": "unhealthy",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Restarts (24h)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(nyxgpt_selfheal_restarts_total[24h]))",
          "legendFormat": "restarts",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Consecutive restart count by service (backoff state)",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nyxgpt_selfheal_restart_count",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Restarts by service and outcome",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(nyxgpt_selfheal_restarts_total[5m])) by (service, result)",
          "legendFormat": "{{service}} ({{result}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Time since last successful recovery, by service",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "m" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(time() - nyxgpt_selfheal_last_recovery_timestamp) / 60",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Restart / recovery timeline (self-heal + ops lifecycle events)",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 14 },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessages": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=\"nyxgpt\"} |~ `self-heal: .*(restart|heal pass|giving up|recovered)|ops: lifecycle action`",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Operator ops actions (24h)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(nyxgpt_ops_actions_total[24h]))",
          "legendFormat": "ops actions",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Ops lifecycle actions by command/service/result",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(nyxgpt_ops_actions_total[5m])) by (command, service, result)",
          "legendFormat": "{{command}} {{service}} ({{result}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Unhealthy components by name (now)",
      "description": "Names every unhealthy/stopped component this check pass found -- pairs with the bare 'Unhealthy components (now)' count above, which can't say which service it means.",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 32 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 1,
          "mappings": [
            { "type": "value", "options": { "0": { "text": "unhealthy" }, "1": { "text": "healthy" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nyxgpt_selfheal_component_healthy",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Self-heal check freshness",
      "description": "Seconds since the self-heal watchdog's last check pass -- how stale the unhealthy-component panels above are relative to now. Should stay well under the configured check interval; a large/climbing value means the watchdog loop has stalled.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "time() - nyxgpt_selfheal_last_check_timestamp",
          "legendFormat": "seconds since last check",
          "refId": "A"
        }
      ]
    }
  ]
}
