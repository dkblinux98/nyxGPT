{
  "title": "nyxGPT / Operational Logs",
  "uid": "nyxgpt-operational-logs",
  "tags": ["nyxgpt", "logs", "sre"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "component",
        "type": "custom",
        "label": "Component",
        "query": "nyxgpt.app,nyxgpt.chat,nyxgpt.rag.rag,nyxgpt.self_heal,nyxgpt.deploy,nyxgpt.canary,nyxgpt.error_tracking",
        "includeAll": true,
        "multi": false,
        "current": { "text": "nyxgpt.self_heal", "value": "nyxgpt.self_heal" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Self-heal events (restart / recovery / backoff)",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessages": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=\"nyxgpt\", logger=\"nyxgpt.self_heal\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Deploy events (blue/green switch, rollback)",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessages": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=\"nyxgpt\", logger=\"nyxgpt.deploy\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Canary events (rollout, evaluation, promotion)",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessages": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=\"nyxgpt\", logger=\"nyxgpt.canary\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Chat errors (ERROR / CRITICAL)",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessages": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=\"nyxgpt\", logger=\"nyxgpt.chat\", level=~\"ERROR|CRITICAL\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Per-component logs ($component)",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 24 },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessages": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=\"nyxgpt\", logger=~\"$component\"}",
          "refId": "A"
        }
      ]
    }
  ]
}
