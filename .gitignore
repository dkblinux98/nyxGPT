# Node / MCP tooling
/node_modules/

# JetBrains / IntelliJ
.idea/
.idea/**
*.iml

# Python
.venv/
# Any other local virtualenv (e.g. .venv-agent, created inside agent runners).
# Without this the developer workflow's snapshot step (`git add -A`) commits
# the whole site-packages tree onto the feature branch, which then makes
# verification crawl -- see the #3352 run that hung for 30+ minutes.
.venv*/
__pycache__/
*.py[cod]
*.egg-info/

# macOS
.DS_Store

# Logs
*.log

# Build / coverage output
build/
dist/
out/
coverage/

# Kubernetes (real secrets - copy from k8s/secret.example.yaml)
/k8s/secret.yaml

# Docker Compose (real secrets - copy from .env.example)
/.env

# Live config (contains secrets; the tracked declaration is example.config.ini).
# The real file lives at ~/.nyxGPT/config.ini -- this guards against a copy
# accidentally dropped into the repo.
config.ini

# Live Compose api config: derived per-machine artifact seeded from
# docker/config.docker.ini.example by `nyxgpt ops install`; its DSN is filled
# in at runtime by `nyxgpt ops glitchtip-init`. The .example template stays tracked.
/docker/config.docker.ini

# Terraform (state, plugin cache, real vars - copy from terraform.tfvars.example)
/terraform/.terraform/
/terraform/.terraform.lock.hcl
/terraform/terraform.tfstate
/terraform/terraform.tfstate.*
/terraform/*.tfvars
!/terraform/terraform.tfvars.example
/terraform/crash.log
/terraform/crash.*.log

# Codex/Github/Jupyter
chat_history.md
jupyter-notebooks/

# Project Analysis
claude-project-review/*
# product_management/ is tracked planning docs (owner decision 2026-07-19).
# Scratch that must stay local goes in product_management/private/
product_management/private/
project_management/*
performance_analysis/*
/.coverage

# Scripts
scripts/duplicate_github_issue.py
scripts/delete_github_action_workflow_history.sh
scripts/create_github_agent_config_repo_variables.sh
/.agent-smoke/
/scripts/watch_agents.sh
/scripts/watch_agents_macos.sh
/scripts/test_agent_tokens_from_config.sh
/agents/charters/myGPT-developer-agent.jpeg
/agents/charters/myGPT-review-agent.jpeg
/agents/charters/myGPT-scrummaster-agent.jpeg
agents/charters/myGPT-qa-agent.jpeg
/myGPT notes.txt
/.claude/scheduled_tasks.lock
/.claude/worktrees/

# Terraform saved plan (generated by `terraform plan -out`, ephemeral per run)
/terraform/tfplan
