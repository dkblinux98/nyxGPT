# Node / MCP tooling
/node_modules/

# JetBrains / IntelliJ
.idea/
.idea/**
*.iml

# Python
.venv/
# Any other local virtualenv (e.g. .venv-agent, created inside agent runners).
# Without this the developer workflow's snapshot step (`git add -A`) commits
# the whole site-packages tree onto the feature branch, which then makes
# verification crawl -- see the #3352 run that hung for 30+ minutes.
.venv*/
__pycache__/
*.py[cod]
*.egg-info/
# Tool caches. Never commit these: a `.mypy_cache` written under a different
# dependency set false-fails a later run (see #3730), and shipping one on a
# branch would spread that to every checkout.
.mypy_cache/
.mypy_cache_precommit/
.ruff_cache/
.pytest_cache/

# macOS
.DS_Store
# AppleDouble metadata companions. On this Dropbox-synced checkout these
# appear transiently as real files during sync activity; without this entry
# `git ls-files --others --exclude-standard` lists them, and the cloud --dev
# deploy ships them to the instance as ordinary files (observed 2026-08-22:
# 1,182 shipped in one deploy; Grafana's provisioner then crash-loops parsing
# `._dashboards.yml` as YAML).
._*

# Logs
*.log

# Build / coverage output
build/
dist/
out/
coverage/

# Kubernetes (real secrets - copy from k8s/secret.example.yaml)
/k8s/secret.yaml
# Observability layer secrets (Grafana admin/Slack/GlitchTip) -- bootstrapped
# by `nyxgpt ops install/observability --kubernetes` from
# k8s/observability/secret.example.yaml
/k8s/observability/secret.yaml

# Docker Compose (real secrets - copy from .env.example)
/.env

# Live config (contains secrets; the tracked declaration is example.config.ini).
# The real file lives at ~/.nyxGPT/config.ini -- this guards against a copy
# accidentally dropped into the repo.
config.ini

# Live Compose api config: derived per-machine artifact seeded from
# docker/config.docker.ini.example by `nyxgpt ops install`; its DSN is filled
# in at runtime by `nyxgpt ops glitchtip-init`. The .example template stays tracked.
/docker/config.docker.ini

# Terraform (state, plugin cache, real vars - copy from terraform.tfvars.example)
# Both the local Docker stack (/terraform) and the AWS substrate
# (/terraform/aws, #3509); the AWS state/tfvars a real deploy uses live under
# ~/.nyxGPT/cloud/ anyway, written by `nyxgpt cloud infra`.
/terraform/.terraform/
/terraform/.terraform.lock.hcl
/terraform/terraform.tfstate
/terraform/terraform.tfstate.*
/terraform/*.tfvars
!/terraform/terraform.tfvars.example
/terraform/crash.log
/terraform/crash.*.log
/terraform/aws/.terraform/
/terraform/aws/.terraform.lock.hcl
/terraform/aws/terraform.tfstate
/terraform/aws/terraform.tfstate.*
/terraform/aws/*.tfvars
!/terraform/aws/terraform.tfvars.example
/terraform/aws/crash.log
/terraform/aws/crash.*.log
# The EC2 Mac roots (#3995) are separate root modules, not child modules, so
# each accumulates its own .terraform/ plugin cache and lock file the moment
# anyone runs `terraform init` in it -- which the terraform-aws-validate CI
# gate now does for both. The rules above are anchored at /terraform/aws/ and
# do not reach a subdirectory, so without these the multi-hundred-megabyte
# provider cache shows up as untracked and offers itself for commit.
/terraform/aws/mac/.terraform/
/terraform/aws/mac/.terraform.lock.hcl
/terraform/aws/mac/*.tfstate
/terraform/aws/mac/*.tfstate.*
/terraform/aws/mac/*.tfvars
/terraform/aws/mac/crash.log
/terraform/aws/mac/crash.*.log
/terraform/aws/mac-release/.terraform/
/terraform/aws/mac-release/.terraform.lock.hcl
/terraform/aws/mac-release/*.tfstate
/terraform/aws/mac-release/*.tfstate.*
/terraform/aws/mac-release/*.tfvars
/terraform/aws/mac-release/crash.log
/terraform/aws/mac-release/crash.*.log

