---
# yamllint configuration for nyxAgent

extends: default

rules:
  # Line length - allow up to 120 characters
  line-length:
    max: 120
    level: warning

  # Indentation - 2 spaces
  indentation:
    spaces: 2
    indent-sequences: true

  # Document start - not required (many GitHub Actions don't use ---)
  document-start: disable

  # Comments - require space after #
  comments:
    min-spaces-from-content: 1

  # Truthy values - allow yes/no/on/off in YAML
  truthy:
    allowed-values: ['true', 'false', 'yes', 'no', 'on', 'off']
    check-keys: false

  # Empty lines
  empty-lines:
    max: 2
    max-start: 0
    max-end: 0

  # Trailing spaces - not allowed
  trailing-spaces: enable

  # Key duplicates - error
  key-duplicates: enable

  # Brackets - consistent spacing
  brackets:
    min-spaces-inside: 0
    max-spaces-inside: 1

  # Braces - consistent spacing
  braces:
    min-spaces-inside: 0
    max-spaces-inside: 1

ignore: |
  .venv/
  venv/
  .git/
  __pycache__/
  *.pyc
  .pytest_cache/
  .mypy_cache/
  .ruff_cache/
  dist/
  build/
